    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>Mother3Recomp</string>
    <key>CFBundleIdentifier</key><string>io.github.mother3recomp.ios</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
