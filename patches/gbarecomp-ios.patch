+constexpr uint16_t kDpadBits = 0xF0;  // Right, Left, Up, Down
+
+// Floating stick: 8 directions, so diagonals press two d-pad bits.
+uint16_t stick_buttons(float dx, float dy, float dead) {
+    if (dx * dx + dy * dy < dead * dead) return 0;
+    const float pi = 3.14159265f;
+    const int sector = (static_cast<int>(std::lround(std::atan2(dy, dx) / (pi / 4.0f))) + 8) % 8;
+    static constexpr uint16_t kDirs[8] = {
+        1u << 4,               // right
+        (1u << 4) | (1u << 7), // down-right
+        1u << 7,               // down
+        (1u << 5) | (1u << 7), // down-left
+        1u << 5,               // left
+        (1u << 5) | (1u << 6), // up-left
+        1u << 6,               // up
+        (1u << 4) | (1u << 6), // up-right
+    };
+    return kDirs[sector];
+}
+
+// Gestures and zones: the only drawn buttons (L, R, the held B, and for zones
+// Start/Select); 1 mm of slop keeps R and B, 3 mm apart, from both firing.
+uint16_t gesture_buttons_at(const PadLayout& p, float x, float y, float mm,
+                            bool start_select) {
+    uint16_t buttons = 0;
+    if (start_select && p.start.contains(x, y, mm)) buttons |= 1u << 3;
+    if (start_select && p.select.contains(x, y, mm)) buttons |= 1u << 2;
+    if (p.r.contains(x, y, mm)) buttons |= 1u << 8;
+    if (p.l.contains(x, y, mm)) buttons |= 1u << 9;
+    if (p.b_small.w > 0.0f && p.b_small.contains(x, y, mm)) buttons |= 1u << 1;
+    return buttons;
+}
