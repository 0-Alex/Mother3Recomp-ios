+// LCD grid: dark lines on the boundaries between game pixels, sized to the
+// game's on-screen rectangle so each line lands exactly between two pixels.
+[[maybe_unused]] void draw_lcd_grid(Backend* b, const SDL_Rect& dst) {
+    if (b->lcd_grid <= 0.0f || dst.w <= 0 || dst.h <= 0) return;
+    if (!b->lcd_texture || b->lcd_w != dst.w || b->lcd_h != dst.h ||
+        b->lcd_base_w != b->base_w || b->lcd_base_h != b->base_h) {
+        if (b->lcd_texture) SDL_DestroyTexture(b->lcd_texture);
+        b->lcd_texture = SDL_CreateTexture(b->renderer, SDL_PIXELFORMAT_ARGB8888,
+                                           SDL_TEXTUREACCESS_STATIC, dst.w, dst.h);
+        b->lcd_w = dst.w;
+        b->lcd_h = dst.h;
+        b->lcd_base_w = b->base_w;
+        b->lcd_base_h = b->base_h;
+        if (!b->lcd_texture) return;
+        // ~1/6 of a game pixel, at least one screen pixel.
+        const int line = std::max(1, static_cast<int>(
+            std::lround(static_cast<double>(dst.w) / b->base_w / 6.0)));
+        auto boundaries = [line](int size, int cells) {
+            std::vector<uint8_t> on(static_cast<std::size_t>(size), 0);
+            for (int k = 1; k < cells; ++k) {
+                const int edge = static_cast<int>(static_cast<long long>(k) * size / cells);
+                for (int i = std::max(0, edge - line); i < edge; ++i) on[i] = 1;
+            }
+            return on;
+        };
+        const std::vector<uint8_t> cols = boundaries(dst.w, b->base_w);
+        const std::vector<uint8_t> rows = boundaries(dst.h, b->base_h);
+        const uint32_t dark = static_cast<uint32_t>(std::lround(255.0f * b->lcd_grid)) << 24;
+        std::vector<uint32_t> pixels(static_cast<std::size_t>(dst.w) * dst.h, 0u);
+        for (int y = 0; y < dst.h; ++y)
+            for (int x = 0; x < dst.w; ++x)
+                if (rows[y] || cols[x]) pixels[static_cast<std::size_t>(y) * dst.w + x] = dark;
+        SDL_UpdateTexture(b->lcd_texture, nullptr, pixels.data(), dst.w * 4);
+        SDL_SetTextureBlendMode(b->lcd_texture, SDL_BLENDMODE_BLEND);
+    }
+    SDL_RenderCopy(b->renderer, b->lcd_texture, nullptr, &dst);
+}
