+    {'F', {7, 4, 6, 4, 4}}, {'G', {3, 4, 5, 5, 3}}, {'H', {5, 5, 7, 5, 5}},
+    {'I', {7, 2, 2, 2, 7}}, {'J', {1, 1, 1, 5, 2}}, {'K', {5, 5, 6, 5, 5}},
+    {'L', {4, 4, 4, 4, 7}}, {'M', {5, 7, 7, 5, 5}}, {'N', {6, 5, 5, 5, 5}},
+    {'O', {2, 5, 5, 5, 2}}, {'P', {6, 5, 6, 4, 4}}, {'Q', {2, 5, 5, 6, 3}},
+    {'R', {6, 5, 6, 5, 5}}, {'S', {3, 4, 2, 1, 6}}, {'T', {7, 2, 2, 2, 2}},
+    {'U', {5, 5, 5, 5, 7}}, {'V', {5, 5, 5, 5, 2}}, {'W', {5, 5, 7, 7, 5}},
+    {'X', {5, 5, 2, 5, 5}}, {'Y', {5, 5, 2, 2, 2}}, {'Z', {7, 1, 2, 4, 7}},
+    {'.', {0, 0, 0, 0, 2}}, {':', {0, 2, 0, 2, 0}}, {'/', {1, 1, 2, 4, 4}},
+    {'-', {0, 0, 7, 0, 0}}, {'%', {5, 1, 2, 4, 5}}, {'+', {0, 2, 7, 2, 0}},
+};
+
+const std::uint8_t* hud_glyph(char c) {
+    if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
+    for (const HudGlyph& g : kHudFont)
+        if (g.c == c) return g.rows;
+    return nullptr;
+}
+
+struct HudPainter {
+    SDL_Renderer* r;
+    std::vector<SDL_FRect> rects;
+    float px;  // font pixel size
+    void text(float x, float y, const char* s) {
+        for (; *s; ++s, x += 4.0f * px) {
+            const std::uint8_t* rows = hud_glyph(*s);
+            if (!rows) continue;
+            for (int row = 0; row < 5; ++row)
+                for (int col = 0; col < 3; ++col)
+                    if (rows[row] & (4 >> col))
+                        rects.push_back({x + col * px, y + row * px, px, px});
+        }
+    }
+    void flush(SDL_Color c) {
+        SDL_SetRenderDrawColor(r, c.r, c.g, c.b, c.a);
+        if (!rects.empty()) SDL_RenderFillRectsF(r, rects.data(), static_cast<int>(rects.size()));
+        rects.clear();
+    }
+    void box(float x, float y, float w, float h, SDL_Color c) {
+        SDL_SetRenderDrawColor(r, c.r, c.g, c.b, c.a);
+        const SDL_FRect rect{x, y, w, h};
+        SDL_RenderFillRectF(r, &rect);
+    }
+};
+}  // namespace
